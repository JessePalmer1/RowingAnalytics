# Concept2 API key portal: https://log.concept2.com/developers/keys
# Read-only apps may use production directly. If you ever add results:write, you must
# develop against https://log-dev.concept2.com and get Concept2's approval before going live.
C2_BASE_URL=https://log.concept2.com
C2_CLIENT_ID=
C2_CLIENT_SECRET=
C2_REDIRECT_URI=http://localhost:8000/auth/callback
# Never omit scopes: C2 silently defaults to user:read,results:write.
C2_SCOPES=user:read,results:read

# Leave unset for local mode: an embedded Postgres, no Docker, cleared on exit.
# Set it to keep data in your own Postgres (e.g. the docker-compose one):
# DATABASE_URL=postgresql+psycopg://erg:erg@localhost:5432/erg

# Fernet key for encrypting OAuth tokens at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Signs session cookies. Defaults to TOKEN_ENCRYPTION_KEY when blank.
SESSION_SECRET=
SESSION_DAYS=30
# Set true when served over HTTPS.
SECURE_COOKIES=false

# Fallback when a workout has timezone: null (common on historic rows).
DEFAULT_TIMEZONE=America/New_York
